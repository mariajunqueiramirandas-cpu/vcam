; vcam.inf - installs the virtual webcam driver (vcam.sys).
;
; The device is root-enumerated: vcamctl.exe creates a ROOT\VCAM device node and
; installs this package on it. Modeled on the avshws sample INF from
; https://github.com/microsoft/Windows-driver-samples (MS-PL).

[Version]
Signature   = "$WINDOWS NT$"
Class       = Camera
ClassGuid   = {ca3e7ab9-b4c3-4ae6-8251-579ef933890f}
Provider    = %ProviderName%
CatalogFile = vcam.cat
DriverVer   = 01/01/2026,1.0.0.0
PnpLockdown = 1

[SourceDisksNames]
1 = %DiskName%,,,

[SourceDisksFiles]
vcam.sys = 1

[DestinationDirs]
DefaultDestDir = 13
VCam.CopyFiles = 13

[Manufacturer]
%ManufacturerName% = Standard,NTamd64.10.0...19041

[Standard.NTamd64.10.0...19041]
%VCam.DeviceDesc% = VCam, ROOT\VCAM

[VCam]
Include   = ks.inf, kscaptur.inf
Needs     = KS.Registration, KSCAPTUR.Registration.NT
CopyFiles = VCam.CopyFiles

[VCam.CopyFiles]
vcam.sys

; Register the capture filter under the categories applications enumerate.
; KSCATEGORY_VIDEO_CAMERA is what makes it show up as a camera to the Windows
; camera stack; the proxy CLSID is what lets DirectShow open it.
[VCam.Interfaces]
AddInterface = %KSCATEGORY_CAPTURE%,      "GLOBAL", VCam.Interface
AddInterface = %KSCATEGORY_VIDEO%,        "GLOBAL", VCam.Interface
AddInterface = %KSCATEGORY_VIDEO_CAMERA%, "GLOBAL", VCam.Interface

[VCam.Interface]
AddReg = VCam.Interface.AddReg

[VCam.Interface.AddReg]
HKR,,CLSID,,%Proxy.CLSID%
HKR,,FriendlyName,,%VCam.FriendlyName%

[VCam.Services]
AddService = vcam, 0x00000002, VCam.ServiceInstall

[VCam.ServiceInstall]
DisplayName   = %VCam.DeviceDesc%
ServiceType   = 1  ; SERVICE_KERNEL_DRIVER
StartType     = 3  ; SERVICE_DEMAND_START
ErrorControl  = 1  ; SERVICE_ERROR_NORMAL
ServiceBinary = %13%\vcam.sys

[Strings]
; non-localizable
Proxy.CLSID                = "{17CCA71B-ECD7-11D0-B908-00A0C9223196}"
KSCATEGORY_CAPTURE         = "{65E8773D-8F56-11D0-A3B9-00A0C9223196}"
KSCATEGORY_VIDEO           = "{6994AD05-93EF-11D0-A3CC-00A0C9223196}"
KSCATEGORY_VIDEO_CAMERA    = "{E5323777-F976-4f5b-9B55-B94699C46E44}"

; localizable - change these to rename the camera shown to applications
ProviderName       = "vcam"
ManufacturerName   = "vcam"
DiskName           = "vcam installation disk"
VCam.DeviceDesc    = "Virtual Webcam"
VCam.FriendlyName  = "Virtual Webcam"
